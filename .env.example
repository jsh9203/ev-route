# EV Route 환경변수 템플릿
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올리지 않음)

# ── TMAP (https://tmapapi.tmapmobility.com) ─────────────────
# 서버 전용: 경로 탐색 / POI 검색. 브라우저에 노출되지 않음.
TMAP_APP_KEY=

# 브라우저 지도 SDK용. 서버가 /api/v1/config 로 런타임에 전달 (빌드에 포함되지 않음).
# 브라우저에 노출되므로 TMAP 콘솔에서 허용 도메인 제한 필수 (localhost, 추후 NAS 도메인).
# 비워두면 TMAP_APP_KEY 를 사용.
TMAP_WEB_APP_KEY=

# ── 공공데이터포털 (https://www.data.go.kr) ────────────────
# 한국환경공단 전기자동차 충전소 정보 (getChargerInfo / getChargerStatus)
# 포털에서 발급받은 "일반 인증키(Decoding)" 값
DATA_GO_KR_SERVICE_KEY=

# ── Git / GitHub (이 저장소 전용, 전역 계정과 분리) ─────────
# scripts/setup-git.ps1 이 읽어서 이 저장소에만 local 설정으로 적용.
# 커밋 작성자 정보
GIT_USER_NAME=
GIT_USER_EMAIL=
# 푸시에 사용할 GitHub 개인 계정 ID (remote URL 에 포함되어 전역 계정과 자격증명이 분리됨)
GITHUB_USERNAME=
# 저장소 이름 (예: ev-route). 비워두면 remote 등록 생략
GITHUB_REPO=
# ※ 토큰/비밀번호는 여기에 넣지 마세요. 첫 push 때 Git Credential Manager 로그인 창에서
#   개인 계정으로 로그인하면 OS 자격증명 저장소에 계정별로 따로 저장됩니다.

# ── 서버 설정 ───────────────────────────────────────────────
# 운영(Docker)에서는 이 포트 하나로 API + 웹을 함께 서빙
PORT=3001
# 개발 시 Vite dev 서버 포트 (/api 는 PORT 로 프록시)
WEB_DEV_PORT=5173
# SQLite DB 경로 (Docker 에서는 볼륨 마운트 경로)
DB_PATH=./data/stations.sqlite
# 실시간 충전기 상태 캐시 TTL(초)
STATUS_CACHE_TTL_SEC=120
# 충전소 정적 데이터 갱신 주기(시간)
STATION_SYNC_INTERVAL_HOURS=24
